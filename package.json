{
  "name": "directus-extension-seed-studio",
  "description": "Generate realistic schema-aware test data for any Directus project — in one click. Detects field types, interfaces, and relationships; produces Faker-powered realistic content.",
  "icon": "auto_awesome",
  "version": "1.1.0",
  "type": "module",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-custom-bundle",
    "seed",
    "seeder",
    "faker",
    "fixtures",
    "test-data",
    "mock-data",
    "dummy-data",
    "data-generator",
    "schema-aware"
  ],
  "author": {
    "name": "Ahmad Khan",
    "url": "https://github.com/khanahmad4527"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khanahmad4527/directus-extension-seed-studio.git"
  },
  "bugs": {
    "url": "https://github.com/khanahmad4527/directus-extension-seed-studio/issues"
  },
  "homepage": "https://github.com/khanahmad4527/directus-extension-seed-studio#readme",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "directus:extension": {
    "host": "^11.0.0 || ^12.0.0",
    "type": "bundle",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "module",
        "name": "seed-studio-module",
        "source": "src/module/index.ts"
      },
      {
        "type": "endpoint",
        "name": "seed-studio-endpoint",
        "source": "src/endpoint/index.ts"
      }
    ]
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@faker-js/faker": "9.9.0"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "11.0.10",
    "@types/node": "20.19.41",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vue": "3.5.34"
  },
  "files": [
    "dist"
  ]
}
